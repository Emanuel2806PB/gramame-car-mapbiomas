<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Analise" targetNamespace="http://ifbaiano.edu.br/tcc/gramame">
  <bpmn:process id="Process_Analise" name="Análise de convergência e validação" isExecutable="false">
    <bpmn:startEvent id="Start" name="Dados preparados"><bpmn:outgoing>S1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Union" name="Unir polígonos declarados e calcular sobreposição"><bpmn:incoming>S1</bpmn:incoming><bpmn:outgoing>S2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Rasterize" name="Rasterizar máscara na grade MapBiomas"><bpmn:incoming>S2</bpmn:incoming><bpmn:outgoing>S3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Reclass" name="Reclassificar classes naturais e não naturais"><bpmn:incoming>S3</bpmn:incoming><bpmn:outgoing>S4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Overlay" name="Cruzar CAR e MapBiomas"><bpmn:incoming>S4</bpmn:incoming><bpmn:outgoing>S5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Indicators" name="Calcular áreas e índice de convergência"><bpmn:incoming>S5</bpmn:incoming><bpmn:outgoing>S6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="CheckArithmetic" name="Identidades aritméticas válidas?"><bpmn:incoming>S6</bpmn:incoming><bpmn:outgoing>S7</bpmn:outgoing><bpmn:outgoing>S8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="ReviewParams" name="Revisar classes, máscara e parâmetros"><bpmn:incoming>S8</bpmn:incoming><bpmn:outgoing>S9</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="Parallel" name="Gerar produtos"><bpmn:incoming>S7</bpmn:incoming><bpmn:outgoing>S10</bpmn:outgoing><bpmn:outgoing>S11</bpmn:outgoing><bpmn:outgoing>S12</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="Tables" name="Gerar CSV, JSON e log"><bpmn:incoming>S10</bpmn:incoming><bpmn:outgoing>S13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Maps" name="Gerar mapas e projeto QGIS"><bpmn:incoming>S11</bpmn:incoming><bpmn:outgoing>S14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Tests" name="Executar testes automatizados"><bpmn:incoming>S12</bpmn:incoming><bpmn:outgoing>S15</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="Join" name="Consolidar validações"><bpmn:incoming>S13</bpmn:incoming><bpmn:incoming>S14</bpmn:incoming><bpmn:incoming>S15</bpmn:incoming><bpmn:outgoing>S16</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="VisualQA" name="Conferir resultados no QGIS e no artigo"><bpmn:incoming>S16</bpmn:incoming><bpmn:outgoing>S17</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Approved" name="Produtos aprovados?"><bpmn:incoming>S17</bpmn:incoming><bpmn:outgoing>S18</bpmn:outgoing><bpmn:outgoing>S19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Correct" name="Corrigir processamento ou representação"><bpmn:incoming>S19</bpmn:incoming><bpmn:outgoing>S20</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Publish" name="Organizar pacote reproduzível"><bpmn:incoming>S18</bpmn:incoming><bpmn:outgoing>S21</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End" name="Resultados disponíveis"><bpmn:incoming>S21</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="S1" sourceRef="Start" targetRef="Union"/><bpmn:sequenceFlow id="S2" sourceRef="Union" targetRef="Rasterize"/><bpmn:sequenceFlow id="S3" sourceRef="Rasterize" targetRef="Reclass"/><bpmn:sequenceFlow id="S4" sourceRef="Reclass" targetRef="Overlay"/><bpmn:sequenceFlow id="S5" sourceRef="Overlay" targetRef="Indicators"/><bpmn:sequenceFlow id="S6" sourceRef="Indicators" targetRef="CheckArithmetic"/>
    <bpmn:sequenceFlow id="S7" name="Sim" sourceRef="CheckArithmetic" targetRef="Parallel"/><bpmn:sequenceFlow id="S8" name="Não" sourceRef="CheckArithmetic" targetRef="ReviewParams"/><bpmn:sequenceFlow id="S9" sourceRef="ReviewParams" targetRef="Rasterize"/>
    <bpmn:sequenceFlow id="S10" sourceRef="Parallel" targetRef="Tables"/><bpmn:sequenceFlow id="S11" sourceRef="Parallel" targetRef="Maps"/><bpmn:sequenceFlow id="S12" sourceRef="Parallel" targetRef="Tests"/>
    <bpmn:sequenceFlow id="S13" sourceRef="Tables" targetRef="Join"/><bpmn:sequenceFlow id="S14" sourceRef="Maps" targetRef="Join"/><bpmn:sequenceFlow id="S15" sourceRef="Tests" targetRef="Join"/>
    <bpmn:sequenceFlow id="S16" sourceRef="Join" targetRef="VisualQA"/><bpmn:sequenceFlow id="S17" sourceRef="VisualQA" targetRef="Approved"/><bpmn:sequenceFlow id="S18" name="Sim" sourceRef="Approved" targetRef="Publish"/><bpmn:sequenceFlow id="S19" name="Não" sourceRef="Approved" targetRef="Correct"/><bpmn:sequenceFlow id="S20" sourceRef="Correct" targetRef="Indicators"/><bpmn:sequenceFlow id="S21" sourceRef="Publish" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Analise"><bpmndi:BPMNPlane id="Plane_Analise" bpmnElement="Process_Analise">
    <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="70" y="190" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Union_di" bpmnElement="Union"><dc:Bounds x="140" y="168" width="145" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Raster_di" bpmnElement="Rasterize"><dc:Bounds x="325" y="168" width="145" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Reclass_di" bpmnElement="Reclass"><dc:Bounds x="510" y="168" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Overlay_di" bpmnElement="Overlay"><dc:Bounds x="700" y="168" width="130" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Indicators_di" bpmnElement="Indicators"><dc:Bounds x="870" y="168" width="155" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Check_di" bpmnElement="CheckArithmetic" isMarkerVisible="true"><dc:Bounds x="1065" y="183" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Review_di" bpmnElement="ReviewParams"><dc:Bounds x="1030" y="45" width="155" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Parallel_di" bpmnElement="Parallel"><dc:Bounds x="1170" y="183" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Tables_di" bpmnElement="Tables"><dc:Bounds x="1260" y="45" width="145" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Maps_di" bpmnElement="Maps"><dc:Bounds x="1260" y="173" width="145" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Tests_di" bpmnElement="Tests"><dc:Bounds x="1260" y="300" width="145" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Join_di" bpmnElement="Join"><dc:Bounds x="1445" y="183" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Visual_di" bpmnElement="VisualQA"><dc:Bounds x="1535" y="168" width="155" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Approved_di" bpmnElement="Approved" isMarkerVisible="true"><dc:Bounds x="1730" y="183" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Correct_di" bpmnElement="Correct"><dc:Bounds x="1680" y="300" width="150" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Publish_di" bpmnElement="Publish"><dc:Bounds x="1820" y="168" width="145" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="2010" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="S1_di" bpmnElement="S1"><di:waypoint x="106" y="208"/><di:waypoint x="140" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S2_di" bpmnElement="S2"><di:waypoint x="285" y="208"/><di:waypoint x="325" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S3_di" bpmnElement="S3"><di:waypoint x="470" y="208"/><di:waypoint x="510" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S4_di" bpmnElement="S4"><di:waypoint x="660" y="208"/><di:waypoint x="700" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S5_di" bpmnElement="S5"><di:waypoint x="830" y="208"/><di:waypoint x="870" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S6_di" bpmnElement="S6"><di:waypoint x="1025" y="208"/><di:waypoint x="1065" y="208"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="S7_di" bpmnElement="S7"><di:waypoint x="1115" y="208"/><di:waypoint x="1170" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S8_di" bpmnElement="S8"><di:waypoint x="1090" y="183"/><di:waypoint x="1107" y="120"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S9_di" bpmnElement="S9"><di:waypoint x="1030" y="82"/><di:waypoint x="397" y="82"/><di:waypoint x="397" y="168"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="S10_di" bpmnElement="S10"><di:waypoint x="1195" y="183"/><di:waypoint x="1195" y="80"/><di:waypoint x="1260" y="80"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S11_di" bpmnElement="S11"><di:waypoint x="1220" y="208"/><di:waypoint x="1260" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S12_di" bpmnElement="S12"><di:waypoint x="1195" y="233"/><di:waypoint x="1195" y="335"/><di:waypoint x="1260" y="335"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="S13_di" bpmnElement="S13"><di:waypoint x="1405" y="80"/><di:waypoint x="1470" y="80"/><di:waypoint x="1470" y="183"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S14_di" bpmnElement="S14"><di:waypoint x="1405" y="208"/><di:waypoint x="1445" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S15_di" bpmnElement="S15"><di:waypoint x="1405" y="335"/><di:waypoint x="1470" y="335"/><di:waypoint x="1470" y="233"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="S16_di" bpmnElement="S16"><di:waypoint x="1495" y="208"/><di:waypoint x="1535" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S17_di" bpmnElement="S17"><di:waypoint x="1690" y="208"/><di:waypoint x="1730" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S18_di" bpmnElement="S18"><di:waypoint x="1780" y="208"/><di:waypoint x="1820" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S19_di" bpmnElement="S19"><di:waypoint x="1755" y="233"/><di:waypoint x="1755" y="300"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S20_di" bpmnElement="S20"><di:waypoint x="1680" y="335"/><di:waypoint x="947" y="335"/><di:waypoint x="947" y="248"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="S21_di" bpmnElement="S21"><di:waypoint x="1965" y="208"/><di:waypoint x="2010" y="208"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
